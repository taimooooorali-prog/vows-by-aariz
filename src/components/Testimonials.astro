---
import { ArrowLeft, ArrowRight, Star } from 'lucide-astro';

const testimonials = [
  {
    quote:
      'Aariz didn’t just take photos — he caught the moments we didn’t even see happening. My mother crying during the rukhsati, my father’s laugh, the chaos of the baraat. We relive our wedding every time we open the gallery.',
    names: 'Ayesha & Bilal',
    city: 'Lahore',
  },
  {
    quote:
      'We were nervous in front of the camera. Within ten minutes it felt like a friend was just hanging out with us. The teaser film made our whole family cry — twice. Worth every rupee, and then some.',
    names: 'Mahnoor & Hamza',
    city: 'Karachi',
  },
  {
    quote:
      'Professional from the first call to the final album. On time, invisible when it mattered, and everywhere when it counted. The drone shots of our Islamabad venue at dusk are the ones everyone asks about.',
    names: 'Zara & Daniyal',
    city: 'Islamabad',
  },
];
---

<section id="testimonials" class="scroll-mt-24 py-[90px] lg:scroll-mt-[92px]" aria-label="Reviews">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="rounded-[32px] bg-blush px-6 py-12 sm:px-10 lg:px-14 lg:py-16">
      <p class="reveal text-center text-xs font-bold uppercase tracking-widest2 text-rose">Reviews</p>
      <h2 class="reveal mt-4 text-center font-display text-5xl font-normal leading-[1.05] tracking-tight text-ink sm:text-6xl">What couples say</h2>
      <p class="reveal mt-4 flex items-center justify-center gap-2 text-sm font-semibold text-ink">
        <span class="flex gap-0.5" role="img" aria-label="Rated 5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => <Star size={15} class="fill-rose text-rose" aria-hidden="true" />)}
        </span>
        5.0 from 87 demo reviews
      </p>

      <div class="mt-12 grid items-center gap-10 lg:grid-cols-2 lg:gap-14" data-reviews-carousel>
        <img
          src="/images/gallery-02.webp"
          alt="Couple in traditional South Asian wedding attire sharing a romantic moment outdoors"
          width="900"
          height="1200"
          loading="lazy"
          decoding="async"
          class="reveal aspect-[4/5] w-full rounded-[24px] object-cover lg:aspect-[3/4]"
        />

        <div>
          <div aria-live="polite">
            {testimonials.map((t, i) => (
              <figure class="review-card" data-review={i} hidden={i !== 0}>
                <p class="font-display text-7xl font-normal leading-[0.6] text-rose" aria-hidden="true">“</p>
                <blockquote class="mt-4 font-display text-[1.6rem] font-normal leading-snug text-ink sm:text-[1.8rem]">
                  {t.quote}
                </blockquote>
                <figcaption class="mt-6">
                  <span class="flex gap-1" role="img" aria-label="Rated 5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <Star size={16} class="fill-rose text-rose" aria-hidden="true" />
                    ))}
                  </span>
                  <span class="mt-3 block font-display text-2xl font-normal text-ink">{t.names}</span>
                  <span class="mt-0.5 block text-[15px] text-body">{t.city}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="mt-8 flex items-center gap-4">
            <button type="button" class="btn-circle" data-r-prev aria-label="Previous review">
              <ArrowLeft size={18} aria-hidden="true" />
            </button>
            <button type="button" class="btn-circle" data-r-next aria-label="Next review">
              <ArrowRight size={18} aria-hidden="true" />
            </button>
            <p class="text-sm font-medium tabular-nums tracking-[0.18em] text-body" aria-hidden="true">
              <span data-r-counter>1 / 3</span>
            </p>
            <p class="sr-only" role="status" data-r-status>Review 1 of 3</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
