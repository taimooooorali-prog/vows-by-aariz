---
import { Star } from 'lucide-astro';

const testimonials = [
  {
    quote:
      'Aariz didn’t just take photos — he caught the moments we didn’t even see happening. My mother crying during the rukhsati, my father’s laugh, the chaos of the baraat. We relive our wedding every time we open the gallery.',
    names: 'Ayesha & Bilal',
    city: 'Lahore',
  },
  {
    quote:
      'We were nervous in front of the camera. Within ten minutes it felt like a friend was just hanging out with us. The teaser film made our whole family cry — twice. Worth every rupee, and then some.',
    names: 'Mahnoor & Hamza',
    city: 'Karachi',
  },
  {
    quote:
      'Professional from the first call to the final album. On time, invisible when it mattered, and everywhere when it counted. The drone shots of our Islamabad venue at dusk are the ones everyone asks about.',
    names: 'Zara & Daniyal',
    city: 'Islamabad',
  },
];
---

<section id="testimonials" class="scroll-mt-24 bg-paper py-16 lg:scroll-mt-[111px] lg:py-20" aria-label="Testimonials">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-4xl font-normal leading-[1.05] tracking-tight sm:text-5xl">What couples say</h2>
      <p class="flex items-center gap-2 text-sm font-semibold text-ink">
        <span class="flex gap-0.5" role="img" aria-label="Rated 5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => <Star size={15} class="fill-main text-main" aria-hidden="true" />)}
        </span>
        5.0 average · 87 reviews
      </p>
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
      {testimonials.map((t) => (
        <figure class="reveal flex flex-col border-t border-hairline pt-6">
          <div class="flex gap-1" role="img" aria-label="Rated 5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <Star size={16} class="fill-main text-main" aria-hidden="true" />
            ))}
          </div>
          <blockquote class="mt-4 flex-1 font-display text-[1.45rem] font-normal leading-snug text-ink">“{t.quote}”</blockquote>
          <figcaption class="mt-5 text-[15px]">
            <span class="block font-bold text-ink">{t.names}</span>
            <span class="block text-main">{t.city}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
