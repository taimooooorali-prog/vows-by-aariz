---
import { Plus } from 'lucide-astro';

const faqs = [
  {
    q: 'How far in advance should we book?',
    a: 'Three to six months is ideal, especially for the November–February wedding season when dates fill fastest. That said, if your date is free even a few weeks out, we will make it work — ask first, we rarely say no.',
  },
  {
    q: 'Do you travel outside Lahore?',
    a: 'Yes. We photograph weddings across Pakistan — Karachi, Islamabad, Murree, Hunza and everywhere in between. Travel and stay for out-of-city weddings is charged at cost and quoted upfront, with no surprises later.',
  },
  {
    q: 'When will we receive our photos and film?',
    a: 'A sneak peek of 20–30 edited highlights arrives within 48 hours of your event. Your full online gallery is delivered in 3–4 weeks (2 weeks on the Signature package), and cinematic films in 6–8 weeks.',
  },
  {
    q: 'Do we get the raw, unedited files?',
    a: 'No — and that is deliberate. Every delivered photo is hand-edited in our signature warm, editorial style, which is the look you booked us for. You receive high-resolution, print-ready JPEGs with full personal-use rights.',
  },
  {
    q: 'How do payments work?',
    a: 'A 30% advance reserves your date. The remaining balance is due one week before the event. We accept bank transfer and JazzCash / EasyPaisa. A simple written agreement covers everything, so both sides are protected.',
  },
  {
    q: 'Do you offer drone coverage?',
    a: 'Yes, drone coverage is included in the Royal package and available as an add-on for other packages. It always depends on venue permission and local regulations — we confirm both before your event, never on the day.',
  },
];
---

<div class="divide-y divide-sand border-y border-sand">
  {faqs.map((f, i) => (
    <div class="faq-item" data-open={i === 0 ? 'true' : 'false'}>
      <h3>
        <button
          type="button"
          class="faq-toggle flex w-full items-center justify-between gap-4 py-5 text-left sm:py-6"
          aria-expanded={i === 0 ? 'true' : 'false'}
        >
          <span class="font-display text-lg font-medium sm:text-xl">{f.q}</span>
          <span class="faq-chevron shrink-0 text-gold" aria-hidden="true"><Plus size={22} /></span>
        </button>
      </h3>
      <div class="faq-panel" role="region">
        <div>
          <p class="max-w-3xl pb-6 leading-relaxed text-smoke">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
