---
import { ArrowLeft, ArrowRight } from 'lucide-astro';
import { GALLERY } from '../data/site';
---

<section id="portfolio" class="scroll-mt-24 py-[90px] lg:scroll-mt-[111px]" aria-label="The Portfolio">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal flex items-center justify-center gap-4 sm:gap-5">
      <h2 class="text-center font-display text-5xl font-normal leading-[1.05] tracking-tight sm:text-6xl">The Portfolio</h2>
      <button type="button" class="btn-circle btn-circle-sm" data-g-next aria-label="Next photos">
        <ArrowRight size={17} aria-hidden="true" />
      </button>
    </div>
    <p class="reveal mx-auto mt-4 max-w-xl text-center text-[1.125rem] leading-relaxed text-main">
      Fifteen frames from recent shaadis. Tap any photo to see it full-screen.
    </p>
  </div>

  <div class="mt-12 overflow-hidden" data-gallery-slider>
    <div id="gallery-track" class="g-track flex gap-4 px-5 sm:px-8">
      {GALLERY.map((p, i) => (
        <figure class="g-slide shrink-0" data-index={i}>
          <button
            type="button"
            class="block aspect-[3/4] w-full appearance-none border-0 bg-transparent p-0"
            data-lightbox-trigger
            data-lb-group="gallery"
            data-lb-index={i}
            data-full={p.src}
            data-alt={p.alt}
            data-caption={`${p.caption} — ${p.event}`}
            aria-label={`View photo: ${p.caption} — ${p.event}`}
          >
            <img
              src={p.src}
              alt={p.alt}
              width={p.w}
              height={p.h}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </button>
        </figure>
      ))}
    </div>

    <div class="mx-auto mt-8 flex max-w-7xl items-center gap-5 px-5 sm:px-8">
      <div class="h-px flex-1 bg-hairline" aria-hidden="true">
        <div id="gallery-progress" class="g-progress-fill h-px bg-main" style="transform: scaleX(0.0667)"></div>
      </div>
      <div class="flex items-center gap-3">
        <button type="button" class="btn-circle" data-g-prev aria-label="Previous photos">
          <ArrowLeft size={18} aria-hidden="true" />
        </button>
        <button type="button" class="btn-circle" data-g-next aria-label="Next photos">
          <ArrowRight size={18} aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</section>
