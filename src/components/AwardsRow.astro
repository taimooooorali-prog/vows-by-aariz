---
/* Original dummy award rosettes — fictional demo honours, designed here as
   inline SVG seals. No real award body names or artwork are used. */
const badges = [
  { top: 'WEDDING PHOTOGRAPHER', bottom: 'OF THE YEAR · 2025', center: '★' },
  { top: 'COUPLES’ CHOICE', bottom: 'AWARD · 2025', center: '★' },
  { top: 'FIVE STAR RATED', bottom: '87 REVIEWS', center: '5.0' },
  { top: 'TOP TEN', bottom: 'LAHORE · 2025', center: '10' },
  { top: 'BEST CINEMATIC FILM', bottom: '2024', center: '★' },
  { top: 'BEST MEHNDI COVERAGE', bottom: '2025', center: '★' },
  { top: 'DESTINATION WEDDING', bottom: 'PRO · 2025', center: '✦' },
  { top: 'EDITORS’ PICK', bottom: '2025', center: '★' },
];
---

<section class="px-5 py-14 sm:px-8 lg:py-20" aria-label="Demo honours and ratings">
  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 lg:grid-cols-8">
    {badges.map((b, i) => (
      <svg
        viewBox="0 0 170 170"
        class="mx-auto h-auto w-full max-w-[120px] text-main sm:max-w-[150px] lg:max-w-[170px]"
        role="img"
        aria-label={`${b.top} — ${b.bottom}`}
      >
        <defs>
          <path id={`badge-top-${i}`} d="M 85,85 m -68,0 a 68,68 0 1,1 136,0 a 68,68 0 1,1 -136,0" fill="none" />
          <path id={`badge-bottom-${i}`} d="M 85,85 m -56,0 a 56,56 0 1,0 112,0 a 56,56 0 1,0 -112,0" fill="none" />
        </defs>
        <circle cx="85" cy="85" r="82" fill="none" stroke="currentColor" stroke-width="1.2" />
        <circle cx="85" cy="85" r="76" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.55" />
        <circle cx="85" cy="85" r="46" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.55" />
        <text font-size="10.5" letter-spacing="2.2" fill="currentColor" font-family="Inter, system-ui, sans-serif" font-weight="600">
          <textPath href={`#badge-top-${i}`} startOffset="25%" text-anchor="middle">{b.top}</textPath>
        </text>
        <text font-size="9.5" letter-spacing="2" fill="currentColor" font-family="Inter, system-ui, sans-serif" font-weight="600">
          <textPath href={`#badge-bottom-${i}`} startOffset="25%" text-anchor="middle">{b.bottom}</textPath>
        </text>
        <text x="85" y="95" text-anchor="middle" font-size="26" fill="currentColor" font-family="Georgia, serif">{b.center}</text>
        <text x="30" y="90" text-anchor="middle" font-size="10" fill="currentColor" aria-hidden="true">✦</text>
        <text x="140" y="90" text-anchor="middle" font-size="10" fill="currentColor" aria-hidden="true">✦</text>
      </svg>
    ))}
  </div>
</section>
