---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = 'https://vows-by-aariz.vercel.app/';
const ogImage = `${siteUrl}images/og-image.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': siteUrl,
  name: 'Vows by Aariz',
  description:
    'Wedding photographer in Lahore, Pakistan. Documentary and editorial wedding photography, cinematic films, pre-wedding shoots, albums and prints across Pakistan.',
  url: siteUrl,
  telephone: '+92-300-0000000',
  email: 'hello@vowsbyaariz.com',
  priceRange: 'PKR 85,000 - PKR 250,000',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
  areaServed: ['Lahore', 'Karachi', 'Islamabad', 'Pakistan'],
  founder: {
    '@type': 'Person',
    name: 'Aariz Ahmed',
    jobTitle: 'Wedding Photographer',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '87',
  },
  openingHours: 'Mo-Sa 10:00-20:00',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Aariz Ahmed" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vows by Aariz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bride in red and groom in a pink turban at a Pakistani wedding" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Self-hosted variable fonts (latin subset): preload the two critical files -->
    <link rel="preload" href="/fonts/eb-garamond.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Hero image preload (LCP element) -->
    <link
      rel="preload"
      as="image"
      imagesrcset="/images/hero-sm.webp 640w, /images/hero-md.webp 960w, /images/hero.webp 1200w"
      imagesizes="(max-width: 640px) 92vw, 560px"
      fetchpriority="high"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>
