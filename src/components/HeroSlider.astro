---
const slides = [
  { src: '/images/hero-slide-1.webp', alt: 'Bride in a vibrant red lehenga and groom in a pink turban smiling at their Pakistani wedding' },
  { src: '/images/hero-slide-2.webp', alt: 'Couple in traditional South Asian wedding attire sharing a romantic moment outdoors' },
  { src: '/images/hero-slide-3.webp', alt: 'Bride and groom in traditional attire posing indoors in modern bridal fashion' },
  { src: '/images/hero-slide-4.webp', alt: 'Couple in traditional attire holding hands outdoors during their wedding photoshoot' },
  { src: '/images/hero-slide-5.webp', alt: 'Outdoor evening event space lit with fairy lights and draped curtains' },
];
---

<section id="top" class="relative h-[100svh] min-h-[560px] overflow-hidden bg-dark" aria-label="Featured wedding photography" data-hero-slider>
  <!-- Slides: black-and-white crossfade -->
  {slides.map((s, i) => (
    <div class={`hero-slide absolute inset-0 ${i === 0 ? 'is-active' : ''}`} data-hero-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
      {i === 0 ? (
        <img
          src={s.src}
          alt={s.alt}
          width="1920"
          height="1080"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          data-src={s.src}
          alt={s.alt}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )}
    </div>
  ))}

  <!-- Legibility scrim -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-black/25" aria-hidden="true"></div>

  <!-- Content -->
  <div class="absolute inset-0 flex flex-col justify-end text-white">
    <div class="mx-auto w-full max-w-7xl px-5 pb-8 sm:px-8 lg:pb-10">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-3xl">
          <h1 class="font-display text-[13vw] font-normal leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.5rem]">
            Every glance.<br />
            Every tear.<br />
            Kept forever.
          </h1>
          <a href="#contact" class="btn-pill btn-pill-light mt-7">Get in Touch</a>
        </div>
        <p class="mb-1 hidden max-w-[240px] text-right text-[11px] font-semibold uppercase leading-relaxed tracking-[0.22em] text-white/85 sm:block">
          Documentary wedding photography<br />&amp; cinematic films · Lahore
        </p>
      </div>

      <!-- Slider controls: bottom-centre -->
      <div class="mt-8 flex items-center justify-center gap-5 sm:gap-7">
        <button
          type="button"
          id="hero-prev"
          class="group flex items-center gap-2 py-2 text-white"
          aria-label="Previous photo"
        >
          <svg width="56" height="12" viewBox="0 0 56 12" fill="none" aria-hidden="true" class="transition-transform duration-150 group-hover:-translate-x-1">
            <line x1="55" y1="6" x2="6" y2="6" stroke="currentColor" stroke-width="1.2" />
            <polyline points="7,1 1,6 7,11" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
          <span class="sr-only">Previous</span>
        </button>
        <p class="min-w-[3.5rem] text-center text-sm font-medium tabular-nums tracking-[0.18em]" aria-hidden="true">
          <span id="hero-counter">1 / 5</span>
        </p>
        <p class="sr-only" role="status" id="hero-status">Slide 1 of 5</p>
        <button
          type="button"
          id="hero-next"
          class="group flex items-center gap-2 py-2 text-white"
          aria-label="Next photo"
        >
          <span class="sr-only">Next</span>
          <svg width="56" height="12" viewBox="0 0 56 12" fill="none" aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-1">
            <line x1="1" y1="6" x2="50" y2="6" stroke="currentColor" stroke-width="1.2" />
            <polyline points="49,1 55,6 49,11" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
