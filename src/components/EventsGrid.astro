---
import { ArrowUpRight } from 'lucide-astro';
import { EVENTS } from '../data/site';
---

<section id="events" class="scroll-mt-24 py-[90px] lg:scroll-mt-[92px]" aria-label="Events">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 class="reveal font-display text-5xl font-normal leading-[1.05] tracking-tight text-ink sm:text-[3.5rem]">Some of Our Events</h2>

    <div class="mt-12 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {EVENTS.map((e, i) => (
        <article id={e.id} class="scroll-mt-24 lg:scroll-mt-[92px]">
          <button
            type="button"
            class="group relative block aspect-[3/4] w-full appearance-none overflow-hidden rounded-[24px] border-0 bg-transparent p-0"
            data-lightbox-trigger
            data-lb-group="events"
            data-lb-index={i}
            data-full={e.photo.src}
            data-alt={e.photo.alt}
            data-caption={`${e.names} — ${e.detail}`}
            aria-label={`View photo: ${e.names} — ${e.detail}`}
          >
            <img
              src={e.photo.src}
              alt={e.photo.alt}
              width={e.photo.w}
              height={e.photo.h}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            />
            <span
              class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-[14px] bg-white text-rose transition-colors duration-150 group-hover:bg-rose group-hover:text-white"
              aria-hidden="true"
            >
              <ArrowUpRight size={20} />
            </span>
          </button>
          <h3 class="mt-4 font-display text-[1.7rem] font-normal leading-[1.15] text-ink">
            {e.names}<br />
            <span class="text-[1.35rem] italic text-body">{e.detail}</span>
          </h3>
        </article>
      ))}
    </div>
  </div>
</section>
