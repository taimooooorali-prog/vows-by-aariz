---

<section id="albums" class="scroll-mt-24 py-[90px] lg:scroll-mt-[92px]" aria-label="Albums">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-center text-xs font-bold uppercase tracking-widest2 text-rose">Films &amp; albums, kept for generations</p>
    <h2 class="reveal mt-4 text-center font-display text-7xl font-normal leading-none tracking-tight text-ink sm:text-8xl lg:text-[7.5rem]">ALBUMS</h2>

    <div class="reveal mx-auto mt-12 max-w-5xl">
      <video
        controls
        preload="metadata"
        poster="/images/showreel-poster.webp"
        class="aspect-video w-full rounded-[24px] bg-dark object-cover"
        aria-label="Demo wedding showreel video"
      >
        <source src="/videos/showreel.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <p class="mt-4 text-center text-sm leading-relaxed text-body">
        Showreel — a fourteen-second glimpse of a wedding morning. Demo footage via Pexels.
      </p>
    </div>
  </div>
</section>
