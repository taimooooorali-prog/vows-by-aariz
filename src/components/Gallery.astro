---
import { Expand } from 'lucide-astro';

interface Photo {
  src: string;
  alt: string;
  category: 'ceremony' | 'candid' | 'details';
  caption: string;
  event: string;
  w: number;
  h: number;
}

const photos: Photo[] = [
  { src: '/images/gallery-01.webp', alt: 'Close-up of a smiling bride with her eyes closed hugging her groom', category: 'candid', caption: 'The quiet embrace', event: 'Nikkah · Lahore', w: 1200, h: 1500 },
  { src: '/images/gallery-02.webp', alt: 'Couple in traditional South Asian wedding attire sharing a romantic moment outdoors', category: 'ceremony', caption: 'Golden hour vows', event: 'Baraat · Islamabad', w: 1200, h: 1800 },
  { src: '/images/gallery-03.webp', alt: 'Indian bride and groom in traditional attire embracing joyfully outdoors', category: 'ceremony', caption: 'Pure joy', event: 'Walima · Karachi', w: 1200, h: 1800 },
  { src: '/images/gallery-06.webp', alt: 'Close-up of a bride’s hands decorated with intricate henna', category: 'details', caption: 'Henna stories', event: 'Mehndi · Lahore', w: 1200, h: 800 },
  { src: '/images/gallery-04.webp', alt: 'Black and white photograph of a wedding couple holding hands', category: 'details', caption: 'Hand in hand', event: 'Nikkah · Lahore', w: 1200, h: 2134 },
  { src: '/images/gallery-05.webp', alt: 'Black and white silhouette portrait of a bride and groom at sunset', category: 'candid', caption: 'Silhouette at dusk', event: 'Rukhsati · Murree', w: 1200, h: 1500 },
  { src: '/images/gallery-08.webp', alt: 'Newlyweds dancing under twinkling lights surrounded by guests holding sparklers', category: 'candid', caption: 'Sparkler send-off', event: 'Walima · Karachi', w: 1200, h: 801 },
  { src: '/images/gallery-07.webp', alt: 'Close-up of a couple’s hands during a wedding ritual with henna art', category: 'details', caption: 'The ritual', event: 'Mehndi · Faisalabad', w: 1200, h: 1500 },
  { src: '/images/gallery-12.webp', alt: 'Bride and groom in traditional attire posing indoors in modern bridal fashion', category: 'ceremony', caption: 'The portrait', event: 'Baraat · Lahore', w: 1200, h: 1800 },
  { src: '/images/gallery-09.webp', alt: 'Sunset-lit outdoor wedding reception setup with adorned tables and chairs', category: 'details', caption: 'The setting', event: 'Walima · Islamabad', w: 1200, h: 1480 },
  { src: '/images/gallery-11.webp', alt: 'Outdoor evening event space lit with fairy lights and draped curtains', category: 'details', caption: 'A thousand lights', event: 'Qawwali Night · Lahore', w: 1200, h: 800 },
  { src: '/images/gallery-13.webp', alt: 'Traditional couple in classic wedding attire sharing a joyful moment indoors', category: 'ceremony', caption: 'Laughter, kept', event: 'Nikkah · Karachi', w: 1200, h: 1800 },
  { src: '/images/gallery-10.webp', alt: 'Lavish wedding table with floral arrangements and hanging lights', category: 'details', caption: 'Table for two hundred', event: 'Walima · Lahore', w: 1200, h: 1798 },
  { src: '/images/gallery-14.webp', alt: 'Couple in traditional attire holding hands outdoors during their wedding photoshoot', category: 'ceremony', caption: 'Walking together', event: 'Baraat · Hunza', w: 1200, h: 1799 },
];

const filters = [
  { key: 'all', label: 'All work' },
  { key: 'ceremony', label: 'Ceremony' },
  { key: 'candid', label: 'Candid' },
  { key: 'details', label: 'Details' },
];
---

<div class="reveal-up">
  <!-- Filter chips -->
  <div class="flex flex-wrap items-center gap-2 sm:gap-3" role="group" aria-label="Filter portfolio photos">
    {filters.map((f) => (
      <button
        type="button"
        class="filter-chip rounded-full border px-5 py-2 text-sm font-semibold tracking-wide transition-colors duration-300"
        data-filter={f.key}
        aria-pressed={f.key === 'all' ? 'true' : 'false'}
      >
        {f.label}
      </button>
    ))}
  </div>

  <!-- Editorial grid -->
  <div id="gallery-grid" class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
    {photos.map((p, i) => (
      <figure
        class="gallery-item group relative cursor-pointer overflow-hidden rounded-xl bg-cream focus-within:ring-2 focus-within:ring-gold"
        data-category={p.category}
        data-index={i}
        tabindex="0"
        role="button"
        aria-label={`View photo: ${p.caption} — ${p.event}`}
      >
        <div class="aspect-[3/4]" data-lightbox-trigger data-full={p.src} data-alt={p.alt} data-caption={`${p.caption} — ${p.event}`}>
          <img
            src={p.src}
            alt={p.alt}
            width={p.w}
            height={p.h}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <figcaption class="gallery-caption pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-espresso/80 via-espresso/35 to-transparent p-4 pt-12 text-left sm:p-5 sm:pt-16">
          <span>
            <span class="block font-display text-lg italic text-ivory sm:text-xl">{p.caption}</span>
            <span class="mt-0.5 block text-[11px] font-semibold uppercase tracking-widest2 text-goldlight">{p.event}</span>
          </span>
          <span class="mb-1 shrink-0 text-ivory/90" aria-hidden="true"><Expand size={18} /></span>
        </figcaption>
      </figure>
    ))}
  </div>

  <p id="gallery-empty" class="mt-10 hidden text-center text-smoke" role="status">No photos in this category yet.</p>
</div>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-espresso/95 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
  hidden
>
  <button type="button" id="lightbox-close" class="absolute right-4 top-4 z-10 rounded-full border border-ivory/30 px-4 py-2 text-sm font-semibold text-ivory transition-colors hover:bg-ivory hover:text-espresso" aria-label="Close photo viewer">Close ✕</button>
  <button type="button" id="lightbox-prev" class="absolute left-3 top-1/2 z-10 -translate-y-1/2 rounded-full border border-ivory/30 px-3 py-2 text-lg text-ivory transition-colors hover:bg-ivory hover:text-espresso sm:left-6" aria-label="Previous photo">←</button>
  <button type="button" id="lightbox-next" class="absolute right-3 top-1/2 z-10 -translate-y-1/2 rounded-full border border-ivory/30 px-3 py-2 text-lg text-ivory transition-colors hover:bg-ivory hover:text-espresso sm:right-6" aria-label="Next photo">→</button>
  <figure class="max-h-full max-w-4xl text-center">
    <img id="lightbox-img" alt="" class="mx-auto max-h-[78vh] w-auto max-w-full rounded-lg object-contain shadow-soft" />
    <figcaption id="lightbox-caption" class="mt-4 font-display text-lg italic text-ivory"></figcaption>
  </figure>
</div>
