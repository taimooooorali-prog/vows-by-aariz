---
---

<form id="booking-form" class="space-y-6 text-left" novalidate>
  <div>
    <label for="field-name" class="mb-2 block text-sm font-bold text-ink">Name</label>
    <input
      id="field-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder="Ayesha & Bilal"
      class="w-full rounded-full border-[1.2px] border-main bg-[#FFFDF2] px-6 py-3.5 text-ink placeholder:text-main/60 focus:outline-none focus:ring-2 focus:ring-main/40"
    />
  </div>

  <div>
    <label for="field-email" class="mb-2 block text-sm font-bold text-ink">Email Address</label>
    <input
      id="field-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="w-full rounded-full border-[1.2px] border-main bg-[#FFFDF2] px-6 py-3.5 text-ink placeholder:text-main/60 focus:outline-none focus:ring-2 focus:ring-main/40"
    />
  </div>

  <div>
    <label for="field-message" class="mb-2 block text-sm font-bold text-ink">Message</label>
    <textarea
      id="field-message"
      name="message"
      rows="5"
      placeholder="Tell us about your celebration — the events, the city, the date if you know it…"
      class="w-full resize-y rounded-[1.75rem] border-[1.2px] border-main bg-[#FFFDF2] px-6 py-4 text-ink placeholder:text-main/60 focus:outline-none focus:ring-2 focus:ring-main/40"
    ></textarea>
  </div>

  <p id="form-error" class="hidden rounded-2xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-semibold text-red-800" role="alert"></p>

  <button type="submit" class="btn-pill w-full">Send Form</button>
  <p class="text-center text-sm leading-relaxed text-main">
    This opens your email app with the enquiry pre-filled — no account or backend needed. We reply within 24 hours.
  </p>
</form>
