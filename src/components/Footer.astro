---
import { Aperture, Facebook, Instagram, Mail, MessageCircle, Phone, Youtube } from 'lucide-astro';

const serviceLinks = [
  { label: 'Wedding Photography', href: '#show-1' },
  { label: 'Cinematic Films', href: '#show-2' },
  { label: 'Mehndi & Sangeet', href: '#show-3' },
  { label: 'Nikkah Ceremony', href: '#show-4' },
  { label: 'Rukhsati & Baraat', href: '#show-5' },
];
const companyLinks = [
  { label: 'About', href: '#about' },
  { label: 'Portfolio', href: '#portfolio' },
  { label: 'Events', href: '#events' },
  { label: 'Reviews', href: '#testimonials' },
  { label: 'Albums', href: '#albums' },
];
const exploreLinks = [
  { label: 'Packages', href: '#packages' },
  { label: 'Contact', href: '#contact' },
  { label: 'Book a Call', href: '#contact' },
  { label: 'FAQs', href: '#contact' },
];

const socials = [
  { label: 'Vows by Aariz on Instagram', href: 'https://www.instagram.com/vowsbyaariz', Icon: Instagram },
  { label: 'Vows by Aariz on YouTube', href: 'https://www.youtube.com/@vowsbyaariz', Icon: Youtube },
  { label: 'Vows by Aariz on Facebook', href: 'https://www.facebook.com/vowsbyaariz', Icon: Facebook },
  { label: 'Chat with Vows by Aariz on WhatsApp', href: 'https://wa.me/923000000000', Icon: MessageCircle },
  { label: 'Email Vows by Aariz', href: 'mailto:hello@vowsbyaariz.com', Icon: Mail },
];
---

<footer class="border-t border-hairline bg-white text-ink">
  <div class="mx-auto max-w-7xl px-5 pb-10 pt-12 sm:px-8">
    <!-- Top strip: wordmark + socials -->
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <a href="#top" class="flex shrink-0 items-center gap-2.5" aria-label="Vows by Aariz — back to top">
        <span class="flex h-10 w-10 items-center justify-center rounded-full border border-current" aria-hidden="true"><Aperture size={20} /></span>
        <span class="font-display text-2xl font-normal tracking-tight">Vows <span class="italic">by Aariz</span></span>
      </a>
      <div class="flex items-center gap-3">
        {socials.map(({ label, href, Icon }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="btn-social"
            aria-label={label}
          >
            <Icon size={18} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>

    <!-- Link columns -->
    <nav class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4" aria-label="Footer navigation">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-ink">Services</h3>
        <ul class="mt-4 space-y-2.5">
          {serviceLinks.map((l) => (
            <li>
              <a href={l.href} class="text-[15px] text-body transition-colors hover:text-rose">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-ink">Company</h3>
        <ul class="mt-4 space-y-2.5">
          {companyLinks.map((l) => (
            <li>
              <a href={l.href} class="text-[15px] text-body transition-colors hover:text-rose">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-ink">Explore</h3>
        <ul class="mt-4 space-y-2.5">
          {exploreLinks.map((l) => (
            <li>
              <a href={l.href} class="text-[15px] text-body transition-colors hover:text-rose">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-ink">Contact</h3>
        <ul class="mt-4 space-y-2.5 text-[15px]">
          <li>
            <a href="tel:+923000000000" class="inline-flex items-center gap-2 text-body transition-colors hover:text-rose">
              <Phone size={15} aria-hidden="true" /> +92 300 0000000
            </a>
          </li>
          <li>
            <a href="mailto:hello@vowsbyaariz.com" class="inline-flex items-center gap-2 text-body transition-colors hover:text-rose">
              <Mail size={15} aria-hidden="true" /> hello@vowsbyaariz.com
            </a>
          </li>
          <li class="text-body">Lahore · Karachi · Islamabad</li>
        </ul>
      </div>
    </nav>
  </div>

  <!-- Bottom bar: thin blush strip -->
  <div class="bg-blush">
    <p class="mx-auto max-w-7xl px-5 py-4 text-center text-sm leading-relaxed text-body sm:px-8">
      © 2026 Vows by Aariz — Demo website. Fictional content. Photography via
      <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer" class="nav-link font-semibold text-ink">Pexels</a>.
    </p>
  </div>
</footer>
