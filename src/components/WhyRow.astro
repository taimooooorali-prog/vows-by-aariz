---
import { ArrowRight, Award, Camera, CreditCard, Receipt, SlidersHorizontal } from 'lucide-astro';

const points = [
  {
    Icon: Receipt,
    title: 'Honest Pricing',
    desc: 'Packages from PKR 85,000, no hidden extras.',
  },
  {
    Icon: Camera,
    title: '8+ Years',
    desc: '250+ weddings across Pakistan.',
  },
  {
    Icon: SlidersHorizontal,
    title: 'Easy Customisation',
    desc: 'Every package shaped around your day.',
  },
  {
    Icon: CreditCard,
    title: 'Flexible Payments',
    desc: 'Book with a small advance, pay in parts.',
  },
  {
    Icon: Award,
    title: 'Award-Winning Style',
    desc: 'Candid, colourful, demo honours.',
  },
];
---

<section class="py-[90px]" aria-label="Why couples choose Vows">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-center text-xs font-bold uppercase tracking-widest2 text-rose">Our promise</p>
    <h2 class="reveal mt-4 text-center font-display text-5xl font-normal leading-[1.05] tracking-tight text-ink sm:text-6xl">
      Why couples choose Vows
    </h2>

    <div class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
      {points.map(({ Icon, title, desc }) => (
        <div class="reveal text-center">
          <p class="flex justify-center text-rose">
            <Icon size={30} aria-hidden="true" />
          </p>
          <h3 class="mt-4 font-bold leading-tight text-ink">{title}</h3>
          <p class="mx-auto mt-2 max-w-[220px] text-[15px] leading-relaxed text-body">{desc}</p>
        </div>
      ))}
    </div>

    <p class="reveal mt-14 text-center">
      <a href="#packages" class="btn-primary">
        Check Packages &amp; Availability
        <ArrowRight size={18} class="btn-arrow" aria-hidden="true" />
      </a>
    </p>
  </div>
</section>
