---
import { ArrowUpRight } from 'lucide-astro';

const cards = [
  {
    eyebrow: 'PACKAGES',
    title: 'Packages & Availability',
    href: '#packages',
    src: '/images/gallery-12.webp',
    alt: 'Bride and groom in traditional attire posing indoors in modern bridal fashion',
  },
  {
    eyebrow: 'PORTFOLIO',
    title: 'Our Portfolio',
    href: '#portfolio',
    src: '/images/gallery-03.webp',
    alt: 'Indian bride and groom in traditional attire embracing joyfully outdoors',
  },
  {
    eyebrow: 'REAL WEDDINGS',
    title: 'Real Weddings',
    href: '#events',
    src: '/images/gallery-13.webp',
    alt: 'Bride and groom in traditional attire standing together in front of a floral wedding stage',
  },
];
---

<section class="pt-10 lg:pt-14" aria-label="Explore packages, portfolio and real weddings">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-5 md:grid-cols-3">
      {cards.map((c) => (
        <a
          href={c.href}
          class="group relative block aspect-[16/10] overflow-hidden rounded-[28px] sm:aspect-[4/3] lg:aspect-[4/5]"
          aria-label={`${c.title} — ${c.eyebrow.toLowerCase()}`}
        >
          <img
            src={c.src}
            alt={c.alt}
            width="900"
            height="1200"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" aria-hidden="true"></div>
          <span
            class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-[14px] bg-white text-rose transition-colors duration-150 group-hover:bg-rose group-hover:text-white"
            aria-hidden="true"
          >
            <ArrowUpRight size={20} />
          </span>
          <span class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <span class="block text-[11px] font-bold uppercase tracking-[0.24em] text-[#F2A9BD]">{c.eyebrow}</span>
            <span class="mt-1.5 block font-display text-[1.7rem] font-normal leading-tight text-white sm:text-3xl">{c.title}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
