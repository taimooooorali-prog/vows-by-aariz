---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import IntroAwards from '../components/IntroAwards.astro';
import Gallery from '../components/Gallery.astro';
import ServicesShowcase from '../components/ServicesShowcase.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyRow from '../components/WhyRow.astro';
import PricesList from '../components/PricesList.astro';
import EventsGrid from '../components/EventsGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import AlbumsSection from '../components/AlbumsSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { MessageCircle } from 'lucide-astro';
---

<BaseLayout
  title="Vows by Aariz — Wedding Photographer in Lahore, Pakistan"
  description="Vows by Aariz is a Lahore wedding photographer capturing shaadis across Pakistan — documentary photography, cinematic films, pre-wedding shoots and albums. 250+ weddings, 8 years, 5.0 rating."
>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[90] focus:rounded-full focus:bg-dark focus:px-5 focus:py-2 focus:text-white">Skip to content</a>

  <Header />

  <main id="main">
    <Hero />
    <FeatureCards />
    <IntroAwards />
    <Gallery />
    <ServicesShowcase />
    <AboutSection />
    <WhyRow />
    <PricesList />
    <EventsGrid />
    <Testimonials />
    <AlbumsSection />

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="scroll-mt-24 py-[90px] lg:scroll-mt-[92px]" aria-label="Contact us">
      <div class="mx-auto max-w-[600px] px-5 text-center sm:px-8">
        <h2 class="reveal font-display text-5xl font-normal leading-[1.05] tracking-tight text-ink sm:text-6xl">Contact Us</h2>
        <p class="reveal mt-4 text-[1.125rem] leading-relaxed text-body">
          Tell us about your celebration and we’ll reply within 24 hours with availability
          and a tailored quote. No obligation — just a conversation.
        </p>
        <div class="reveal mt-10">
          <ContactForm />
        </div>
        <a
          href="https://wa.me/923000000000?text=Hi%20Aariz!%20We%27d%20love%20to%20check%20availability%20for%20our%20wedding."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary reveal mt-6 w-full"
        >
          <MessageCircle size={19} aria-hidden="true" /> Chat on WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <Lightbox />

  <script>
    import '../scripts/site.js';
  </script>
</BaseLayout>
